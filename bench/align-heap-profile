#!/usr/bin/env python3
"""Align a jemalloc baseline profile to a second process's mappings before jeprof --base.

PIE and shared libraries move between processes. Raw cross-process subtraction can
otherwise report impossible negative sites or shares above 100%. Only use profiles
of the same executable and libraries. Allocation totals are never modified.
"""
import argparse
import bisect
from pathlib import Path
import re

p = argparse.ArgumentParser(description=__doc__)
p.add_argument("baseline")
p.add_argument("current")
p.add_argument("--out", required=True)
a = p.parse_args()
base, current = [Path(path).read_text() for path in (a.baseline, a.current)]
marker = "MAPPED_LIBRARIES:\n"
base_body, base_maps = base.split(marker, 1)
_, current_maps = current.split(marker, 1)


def mappings(text):
    result = []
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 6 or "x" not in fields[1] or not fields[5].startswith("/"):
            continue
        start, end = [int(value, 16) for value in fields[0].split("-")]
        result.append((start, end, fields[5], fields[2]))
    return sorted(result)


sources = mappings(base_maps)
starts = [entry[0] for entry in sources]
destinations = {(path, offset): start for start, _, path, offset in mappings(current_maps)}


def align(value):
    address = int(value, 16)
    index = bisect.bisect_right(starts, address) - 1
    assert index >= 0 and address < sources[index][1], f"unmapped baseline PC {value}"
    start, _, path, offset = sources[index]
    assert (path, offset) in destinations, f"missing current mapping for {path}"
    return hex(destinations[path, offset] + address - start)


lines = []
for line in base_body.splitlines(keepends=True):
    if line.startswith("@ "):
        line = re.sub(r"0x[0-9a-fA-F]+", lambda match: align(match[0]), line)
    lines.append(line)
Path(a.out).write_text("".join(lines) + marker + current_maps)
